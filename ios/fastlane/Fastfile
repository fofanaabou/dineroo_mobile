
require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build & upload to TestFlight"
  lane :beta do
    git_token = ENV["MATCH_GIT_TOKEN"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    match(
      type: "appstore",
      readonly: false,
      app_identifier: "com.dineroo.app",
      git_basic_authorization: git_token ? Base64.strict_encode64("x-access-token:#{git_token}") : nil,
      api_key: api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.dineroo.app",
      bundle_identifier: "com.dineroo.app",
      team_id: "26G99557B5"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: "26G99557B5",
        provisioningProfiles: {
          "com.dineroo.app" => "match AppStore com.dineroo.app"
        }
      }
    )
  end
end
