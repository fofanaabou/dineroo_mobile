API_BASE_URL=https://api.dineroo.africa

# Observability (Phase 4b).
# SENTRY_DSN: create a "dineroo-mobile" project in GlitchTip (https://glitchtip.dineroo.africa),
# then paste its DSN here. Empty = crash reporting disabled.
SENTRY_DSN=https://65139795d8a2470aa829912ff97e3960@glitchtip.dineroo.africa/1
SENTRY_ENVIRONMENT=production
# OTLP/HTTP trace ingest (Alloy behind the obs nginx /v1/traces location). Links a mobile action
# to its backend trace in Tempo. Empty = tracing disabled.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://obs.dineroo.africa/v1/traces
